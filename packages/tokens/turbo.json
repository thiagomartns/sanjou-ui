{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/www/registry.json"],
      "outputs": [
        "sanjou.css",
        "tokens.json",
        "CONTRAST.md",
        "figma/**",
        "$TURBO_ROOT$/apps/www/registry.json",
        "$TURBO_ROOT$/apps/www/public/favicon.svg",
        "$TURBO_ROOT$/.github/assets/sanjou-mark.svg",
        "$TURBO_ROOT$/.github/assets/sanjou-mark-dark.svg"
      ]
    }
  }
}
