{
  "name": "@sanjou/tokens",
  "version": "0.1.0",
  "description": "Sanjou UI design tokens: Tailwind CSS 4 theme (OKLCH, light + dark), W3C DTCG JSON and Figma variables.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagomartns/sanjou-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://sanjou-ui.vercel.app",
  "bugs": {
    "url": "https://github.com/thiagomartns/sanjou-ui/issues"
  },
  "author": "Thiago (https://github.com/thiagomartns)",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "sanjou.css",
    "tokens.json",
    "figma",
    "CONTRAST.md"
  ],
  "exports": {
    "./sanjou.css": {
      "style": "./sanjou.css",
      "default": "./sanjou.css"
    },
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/tokens.test.mjs"
  },
  "keywords": [
    "design-tokens",
    "tailwindcss",
    "oklch",
    "shadcn",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "style": "./sanjou.css"
}
