{
  "name": "@sanjou/ui",
  "version": "0.1.0",
  "description": "Sanjou UI React components: shadcn-style, built on Radix and Tailwind CSS 4, compiled from the Sanjou registry sources.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagomartns/sanjou-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://sanjou-ui.vercel.app",
  "bugs": {
    "url": "https://github.com/thiagomartns/sanjou-ui/issues"
  },
  "author": "Thiago (https://github.com/thiagomartns)",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./alert": {
      "types": "./dist/registry/sanjou/ui/alert.d.ts",
      "default": "./dist/registry/sanjou/ui/alert.js"
    },
    "./badge": {
      "types": "./dist/registry/sanjou/ui/badge.d.ts",
      "default": "./dist/registry/sanjou/ui/badge.js"
    },
    "./button": {
      "types": "./dist/registry/sanjou/ui/button.d.ts",
      "default": "./dist/registry/sanjou/ui/button.js"
    },
    "./card": {
      "types": "./dist/registry/sanjou/ui/card.d.ts",
      "default": "./dist/registry/sanjou/ui/card.js"
    },
    "./checkbox": {
      "types": "./dist/registry/sanjou/ui/checkbox.d.ts",
      "default": "./dist/registry/sanjou/ui/checkbox.js"
    },
    "./dialog": {
      "types": "./dist/registry/sanjou/ui/dialog.d.ts",
      "default": "./dist/registry/sanjou/ui/dialog.js"
    },
    "./dropdown-menu": {
      "types": "./dist/registry/sanjou/ui/dropdown-menu.d.ts",
      "default": "./dist/registry/sanjou/ui/dropdown-menu.js"
    },
    "./field": {
      "types": "./dist/registry/sanjou/ui/field.d.ts",
      "default": "./dist/registry/sanjou/ui/field.js"
    },
    "./form": {
      "types": "./dist/registry/sanjou/ui/form.d.ts",
      "default": "./dist/registry/sanjou/ui/form.js"
    },
    "./input": {
      "types": "./dist/registry/sanjou/ui/input.d.ts",
      "default": "./dist/registry/sanjou/ui/input.js"
    },
    "./label": {
      "types": "./dist/registry/sanjou/ui/label.d.ts",
      "default": "./dist/registry/sanjou/ui/label.js"
    },
    "./popover": {
      "types": "./dist/registry/sanjou/ui/popover.d.ts",
      "default": "./dist/registry/sanjou/ui/popover.js"
    },
    "./radio-group": {
      "types": "./dist/registry/sanjou/ui/radio-group.d.ts",
      "default": "./dist/registry/sanjou/ui/radio-group.js"
    },
    "./select": {
      "types": "./dist/registry/sanjou/ui/select.d.ts",
      "default": "./dist/registry/sanjou/ui/select.js"
    },
    "./separator": {
      "types": "./dist/registry/sanjou/ui/separator.d.ts",
      "default": "./dist/registry/sanjou/ui/separator.js"
    },
    "./skeleton": {
      "types": "./dist/registry/sanjou/ui/skeleton.d.ts",
      "default": "./dist/registry/sanjou/ui/skeleton.js"
    },
    "./sonner": {
      "types": "./dist/registry/sanjou/ui/sonner.d.ts",
      "default": "./dist/registry/sanjou/ui/sonner.js"
    },
    "./switch": {
      "types": "./dist/registry/sanjou/ui/switch.d.ts",
      "default": "./dist/registry/sanjou/ui/switch.js"
    },
    "./tabs": {
      "types": "./dist/registry/sanjou/ui/tabs.d.ts",
      "default": "./dist/registry/sanjou/ui/tabs.js"
    },
    "./textarea": {
      "types": "./dist/registry/sanjou/ui/textarea.d.ts",
      "default": "./dist/registry/sanjou/ui/textarea.js"
    },
    "./tooltip": {
      "types": "./dist/registry/sanjou/ui/tooltip.d.ts",
      "default": "./dist/registry/sanjou/ui/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "lint:pkg": "publint && attw --pack . --profile esm-only --format table-flipped"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@sanjou/tokens": "workspace:^",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@sanjou/tokens": "workspace:*",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "publint": "^0.3.25",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.11",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "react",
    "components",
    "radix-ui",
    "tailwindcss",
    "shadcn",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  }
}
