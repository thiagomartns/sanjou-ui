{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/www/registry/sanjou/ui/**",
        "$TURBO_ROOT$/apps/www/lib/**",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/www/registry.json",
        "$TURBO_ROOT$/apps/www/package.json"
      ]
    }
  }
}
